NODE_ENV=development
PORT=5000

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/microsubtracker

# Redis connection string (required)
REDIS_URL=redis://127.0.0.1:6379

# Optional pool tuning
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Auth (required)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Optional auth tuning
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
BCRYPT_COST=10
APP_PUBLIC_URL=http://localhost:5000

# Optional Redis tuning
REDIS_KEY_PREFIX=mst:
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=30
CURRENCY_CACHE_TTL_SECONDS=3600
IDEMPOTENCY_TTL_SECONDS=86400
SESSION_CACHE_TTL_SECONDS=2592000
