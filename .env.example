NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_SSL=auto
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=3
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=15000

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=mst:
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=30
CURRENCY_CACHE_TTL_SECONDS=3600
IDEMPOTENCY_TTL_SECONDS=86400
SESSION_CACHE_TTL_SECONDS=2592000

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
BCRYPT_COST=10
APP_PUBLIC_URL=http://localhost:5000

# Email
EMAIL_PROVIDER=log
EMAIL_FROM=Micro Sub Tracker <onboarding@resend.dev>
RESEND_API_KEY=

# Jobs / Push
JOB_CONCURRENCY=5
JOB_ATTEMPTS=5
JOB_BACKOFF_MS=2000
EXPO_ACCESS_TOKEN=
PUSH_FORCE_LOG=true

# Security
CORS_ORIGINS=*
TRUST_PROXY=false
USER_RATE_LIMIT_MAX=180
ANALYTICS_ADMIN_TOKEN=

# Observability
LOG_LEVEL=info
ERROR_TRACKER_DSN=
